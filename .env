# CONTROL DE MOTOR (Cambia entre 'postgres' o 'mongodb')
DB_ENGINE=postgres

# CONFIGURACION APP
PORT=8000

# POSTGRES
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=restaurante_db
POSTGRES_HOST=db_postgres
POSTGRES_PORT=5432

# MONGODB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=restaurante_db

# KEYCLOAK
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=restaurante-realm
KEYCLOAK_CLIENT_ID=restaurante-api
KEYCLOAK_CLIENT_SECRET=tu_secreto_aqui
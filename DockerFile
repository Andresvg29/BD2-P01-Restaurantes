# Etapa 1: Construccion
FROM golang:1.23 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o main ./api/main.go

# Etapa 2: Ejecucion
FROM alpine:latest
WORKDIR /root/
# Copiamos el binario y el archivo .env
COPY --from=builder /app/main .
COPY --from=builder /app/.env .

EXPOSE 8000
CMD ["./main"]
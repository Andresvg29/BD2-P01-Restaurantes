{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B (recomendado)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (rápido)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "rest-api": {
      "type": "local",
      "command": ["rest-api-mcp-server"],
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md"]
}

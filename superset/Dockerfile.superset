FROM apache/superset:4.1.1

USER root
RUN pip install --no-cache-dir \
    pyhive \
    thrift \
    thrift-sasl \
    psycopg2-binary

COPY init_superset.sh /app/init_superset.sh
RUN chmod +x /app/init_superset.sh

ENV SUPERSET_SECRET_KEY=${SUPERSET_SECRET_KEY:-cambiame_en_produccion}
USER superset
